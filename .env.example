# Copy to .env and adjust. Never commit .env.

# Database — SQLite by default; set a PostgreSQL URL to switch:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/demand_intel
DATABASE_URL=

# LLM reasoning (optional). Without a key the platform runs in DETERMINISTIC mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_ENABLED=true

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
